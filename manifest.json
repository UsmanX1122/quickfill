{
  "manifest_version": 3,
  "name": "QuickFill – Details, Schedule, Todo & Notes",
  "version": "1.1.0",
  "description": "Keep your contact details, class schedule, todos and notes one click away. Copy or insert details into any web form.",
  "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "QuickFill",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
